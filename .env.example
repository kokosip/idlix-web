# IDLIX Web Environment Configuration
# Salin file ini menjadi .env di server VPS Anda agar kredensial rahasia tidak ter-commit ke GitHub.

# Backend API Endpoint
VITE_API_BASE_URL=http://localhost:5000/api

# Pengaturan Akun User VPS (Pilih salah satu metode di bawah)

# Metode A: Menggunakan Variabel Individu
VITE_USER_1_USERNAME=adminvps
VITE_USER_1_PASSWORD=KredensialRahasiaVPS123!
VITE_USER_1_NAME=Pemilik VPS IDLIX

VITE_USER_2_USERNAME=temansaya
VITE_USER_2_PASSWORD=PasswordTeman123!
VITE_USER_2_NAME=User Teman

# Metode B: (Opsional) Menggunakan Format JSON Array
# VITE_INITIAL_USERS='[{"username":"adminvps","password":"KredensialRahasiaVPS123!","name":"Pemilik VPS"}]'

# Firebase Firestore Sync (Isi sesuai kredensial Firebase Console untuk mengaktifkan Cloud Sync multi-device)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
